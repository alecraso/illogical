#!/usr/bin/env bash
# Does this push change what the desktop app is built from? check.yml asks
# before `just desktop-check`, and windows-desktop.yml before building the
# Windows installer, so a daemon- or web-only push compiles no app.
#
#   scripts/app-changed [BEFORE]
#
# See scripts/changed for BEFORE and the exit status.
exec "$(dirname "$0")/changed" "the app" "${1:-}" \
  crates/desktop crates/proto crates/core Cargo.toml THIRD_PARTY.md LICENSE-MIT LICENSE-APACHE \
  .github/workflows/windows-desktop.yml .github/workflows/check.yml scripts/app-changed scripts/changed
