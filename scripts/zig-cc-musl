#!/usr/bin/env bash
# C compiler for x86_64-unknown-linux-musl builds (`just static`): Zig ships
# musl, so no cross toolchain is needed. cc-rs adds a Rust-style
# `--target=x86_64-unknown-linux-musl`, which Zig can't parse; drop it.
# Zig turns on UBSan for unoptimized C (aws-lc builds jitterentropy at -O0),
# whose runtime the Rust linker doesn't bring: turn it off.
args=()
for a in "$@"; do
  case "$a" in
    --target=*) ;;
    *) args+=("$a") ;;
  esac
done
exec zig cc -target x86_64-linux-musl -fno-sanitize=undefined "${args[@]}"
