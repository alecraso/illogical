#!/usr/bin/env bash
# Did this push change any of PATHS? The skip checks for the jobs that only
# matter when certain files change (scripts/app-changed, scripts/macos-changed)
# share this.
#
#   scripts/changed WHAT BEFORE PATH...
#
# WHAT names the job in the message. BEFORE is the push's previous commit
# (github.event.before). On main it's the base; on another branch the base
# is where it left main. Exits 0 (yes, run it) when anything listed changed,
# and whenever it can't tell: a new branch with no base found, a manual run,
# a failed fetch.
set -euo pipefail
what=$1 before=$2
shift 2
paths=("$@")
ref=${GITHUB_REF:-}
yes() { echo "$what may have changed ($1): running it"; exit 0; }
[ "${GITHUB_EVENT_NAME:-push}" = push ] || yes "a ${GITHUB_EVENT_NAME} run"
if [ "$ref" = refs/heads/main ]; then
  [ -n "$before" ] && [ "$before" != 0000000000000000000000000000000000000000 ] || yes "no previous commit"
  depth=()
  [ "$(git rev-parse --is-shallow-repository)" = true ] && depth=(--depth=1)
  git cat-file -e "$before^{commit}" 2>/dev/null || git fetch -q --no-tags "${depth[@]}" origin "$before" 2>/dev/null ||
    yes "can't fetch $before"
  base=$before
else
  # CI's checkout is shallow: fetch enough of this branch and of main to
  # meet. (Never --depth in a full clone: that would make it shallow.)
  if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
    git fetch -q --no-tags --depth=500 origin "+refs/heads/main:refs/remotes/origin/main" "+$ref:refs/remotes/origin/pushed" 2>/dev/null ||
      yes "can't fetch main"
  else
    git fetch -q --no-tags origin "+refs/heads/main:refs/remotes/origin/main" 2>/dev/null || yes "can't fetch main"
  fi
  base=$(git merge-base origin/main HEAD 2>/dev/null) || yes "no merge base with main"
fi
changed=$(git diff --name-only "$base" HEAD -- "${paths[@]}") || yes "can't diff against $base"
[ -n "$changed" ] && yes "$(echo "$changed" | head -3 | tr '\n' ' ')"
echo "nothing $what depends on changed since ${base:0:12}: skipping it"
exit 1
