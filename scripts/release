#!/usr/bin/env bash
# Release steps for .github/workflows/release.yml, with the gh CLI.
#
#   release check-version TAG      the tag matches the workspace version
#   release check-desktop-version TAG   the tag matches the desktop app's
#   release upload TAG FILE...     attach files to TAG's release (made if new)
#   release sums TAG               SHA256SUMS of the release's tarballs
#   release homebrew TAG           bump the formula in the Homebrew tap
#   release updater TAG            latest.json for the desktop app's updater,
#                                  from the release's .sig files
#
# GH_TOKEN (upload, sums) writes releases (in CI, the job token with
# contents: write; by hand, your gh login); HOMEBREW_TAP_KEY (homebrew) is
# an SSH deploy key for the tap (without it, your own key is used).
set -euo pipefail

repo=${GITHUB_REPOSITORY:-arugula-salad/illogical}
tap=git@github.com:arugula-salad/homebrew-tap.git

# The release for a tag, made if it isn't there yet (both build jobs may
# race to make it; the loser finds the winner's).
ensure_release() {
  local tag=$1
  gh release view "$tag" -R "$repo" >/dev/null 2>&1 && return
  gh release create "$tag" -R "$repo" --verify-tag --title "illogical ${tag#v}" \
    --notes "Download the desktop app at https://illogical.widgets.wtf (it installs the daemon). Servers and headless machines: curl -fsSL https://illogical.widgets.wtf/install.sh | sh" >/dev/null 2>&1 \
    || gh release view "$tag" -R "$repo" >/dev/null
}

version() { mise exec -- cargo pkgid -p illogicald | sed 's/.*[#@]//'; }

case "${1:-}" in
  check-version)
    v=$(version)
    [ "$2" = "v$v" ] || { echo "tag $2 doesn't match the workspace version $v" >&2; exit 1; }
    # The desktop app is its own workspace: its version is kept in step.
    d=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/desktop/Cargo.toml | head -1)
    [ "$d" = "$v" ] || { echo "crates/desktop is $d, not $v: bump it too" >&2; exit 1; }
    ;;
  check-desktop-version)
    # Without cargo or mise (the Windows runner builds only the app).
    d=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/desktop/Cargo.toml | head -1)
    [ "$2" = "v$d" ] || { echo "tag $2 doesn't match crates/desktop's version $d" >&2; exit 1; }
    ;;
  upload)
    tag=$2; shift 2
    ensure_release "$tag"
    # --clobber replaces an asset of the same name (a re-run).
    gh release upload "$tag" -R "$repo" --clobber "$@"
    ;;
  sums)
    ensure_release "$2"
    dir=$(mktemp -d)
    gh release download "$2" -R "$repo" -p '*.tar.gz' -p 'illogical-desktop-*' -D "$dir"
    n=$(find "$dir" -name "illogical-[0-9]*.tar.gz" | wc -l | tr -d " ")
    [ "$n" = 4 ] || { echo "expected 4 tarballs, found $n" >&2; exit 1; }
    # Every desktop download a release has (the updater's .app.tar.gz and
    # .sig files come too when TAURI_SIGNING_PRIVATE_KEY is set).
    for f in illogical-desktop-linux-{x86_64,aarch64}.{deb,rpm,AppImage} illogical-desktop-macos-{arm64,x86_64}.{zip,dmg} illogical-desktop-windows-x86_64-setup.exe; do
      [ -f "$dir/$f" ] || { echo "the release has no $f" >&2; exit 1; }
    done
    (cd "$dir" && sha256sum -- illogical-[0-9]*.tar.gz illogical-desktop-* > SHA256SUMS && cat SHA256SUMS)
    gh release upload "$2" -R "$repo" --clobber "$dir/SHA256SUMS"
    ;;
  homebrew)
    tag=$2; v=${tag#v}
    sums=$(curl -fsSL "https://github.com/$repo/releases/download/$tag/SHA256SUMS")
    sha() { echo "$sums" | awk -v f="illogical-$v-$1.tar.gz" '$2 == f { print $1 }'; }
    # The deploy key in CI; by hand, your own SSH key.
    if [ -n "${HOMEBREW_TAP_KEY:-}" ]; then
      key=$(mktemp); trap 'rm -f "$key"' EXIT
      printf '%s\n' "$HOMEBREW_TAP_KEY" > "$key"; chmod 600 "$key"
      export GIT_SSH_COMMAND="ssh -i $key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
    fi
    dir=$(mktemp -d)
    git clone -q "$tap" "$dir"
    mkdir -p "$dir/Formula"
    sed -e "s/@VERSION@/$v/g" \
      -e "s/@SHA_MAC@/$(sha aarch64-apple-darwin)/" \
      -e "s/@SHA_MAC_INTEL@/$(sha x86_64-apple-darwin)/" \
      -e "s/@SHA_LINUX_X86@/$(sha x86_64-unknown-linux-musl)/" \
      -e "s/@SHA_LINUX_ARM@/$(sha aarch64-unknown-linux-musl)/" \
      packaging/homebrew/illogical.rb.in > "$dir/Formula/illogical.rb"
    cd "$dir"
    git add Formula/illogical.rb
    if git diff --cached --quiet; then echo "formula already at $v"; exit 0; fi
    git -c user.name="illogical release" -c user.email="noreply@inevitable.fyi" commit -qm "illogical $v"
    git push -q origin HEAD
    echo "formula bumped to $v"
    ;;
  updater)
    # The Tauri updater's manifest (M46): each platform's download and its
    # signature from the updater key. Without signatures (no
    # TAURI_SIGNING_PRIVATE_KEY in the build jobs) there's nothing to offer.
    tag=$2; v=${tag#v}
    dir=$(mktemp -d)
    gh release download "$tag" -R "$repo" -p '*.sig' -D "$dir" 2>/dev/null || true
    if [ -z "$(ls "$dir")" ]; then
      echo "no latest.json: the release has no updater signatures (the TAURI_SIGNING_PRIVATE_KEY secret isn't set)"
      exit 0
    fi
    base=https://github.com/$repo/releases/download/$tag
    python3 - "$v" "$base" "$dir" >"$dir/latest.json" <<'PY'
import json, os, sys, datetime
v, base, d = sys.argv[1:]
files = {
    "darwin-aarch64": "illogical-desktop-macos-arm64.app.tar.gz",
    "darwin-x86_64": "illogical-desktop-macos-x86_64.app.tar.gz",
    "linux-x86_64": "illogical-desktop-linux-x86_64.AppImage",
    "linux-aarch64": "illogical-desktop-linux-aarch64.AppImage",
}
platforms = {}
for p, f in files.items():
    sig = os.path.join(d, f + ".sig")
    if os.path.exists(sig):
        platforms[p] = {"signature": open(sig).read().strip(), "url": f"{base}/{f}"}
json.dump({"version": v, "pub_date": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
           "platforms": platforms}, sys.stdout, indent=2)
PY
    cat "$dir/latest.json"
    gh release upload "$tag" -R "$repo" --clobber "$dir/latest.json"
    ;;
  *)
    sed -n '2,14p' "$0" >&2
    exit 2
    ;;
esac
