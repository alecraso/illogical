#!/usr/bin/env bash
# Could this push behave differently on macOS? check.yml's macos job asks
# first, so a docs-, site-, testnet- or control-only push doesn't wait on
# GitHub's macOS runner. main runs it on every push regardless. The paths
# are the workspace but control, plus what the macOS job also runs: the web UI
# (the WebKit specs, and the daemon embeds it), the justfile, mise and
# nextest's config.
#
#   scripts/macos-changed [BEFORE]
#
# See scripts/changed for BEFORE and the exit status.
[ "${GITHUB_REF:-}" = refs/heads/main ] && { echo "main: running it"; exit 0; }
exec "$(dirname "$0")/changed" "macOS" "${1:-}" \
  crates ':!crates/control' Cargo.toml Cargo.lock rust-toolchain.toml \
  web justfile .mise.toml .config/nextest.toml .github/workflows/check.yml scripts/macos-changed scripts/changed
