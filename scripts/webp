#!/usr/bin/env python3
"""WebP copies of site/img/*.png for the project page (the README keeps
the PNGs)."""
import pathlib
from PIL import Image

for png in sorted(pathlib.Path(__file__).resolve().parent.parent.joinpath("site/img").glob("*.png")):
    webp = png.with_suffix(".webp")
    Image.open(png).save(webp, "WEBP", quality=86, method=6)
    print(f"{webp.name}: {png.stat().st_size // 1024} KB -> {webp.stat().st_size // 1024} KB")
