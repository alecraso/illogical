#!/usr/bin/env python3
"""WebP copies of the site's PNGs (`scripts/webp DIR`, the site's
apps/site/public/img; `just screenshots` passes it). The README keeps
the PNGs."""
import pathlib
import sys
from PIL import Image

for png in sorted(pathlib.Path(sys.argv[1]).glob("*.png")):
    webp = png.with_suffix(".webp")
    Image.open(png).save(webp, "WEBP", quality=86, method=6)
    print(f"{webp.name}: {png.stat().st_size // 1024} KB -> {webp.stat().st_size // 1024} KB")
