{
  "id": "arugula",
  "version": "0.1.0",
  "name": "Arugula",
  "description": "Puts this dev container's VS Code in your Arugula swarm: the Arugula daemon on the host, reached through its editors' socket.",
  "documentationURL": "https://github.com/arugula-salad/illogical/tree/main/editors/devcontainer",
  "options": {},
  "mounts": [
    {
      "source": "${localEnv:HOME}/.local/state/arugula/editors",
      "target": "/run/arugula",
      "type": "bind"
    }
  ],
  "containerEnv": {
    "ARUGULA_SOCK": "/run/arugula/sock"
  },
  "customizations": {
    "vscode": {
      "extensions": ["arugula.arugula-editor"]
    }
  }
}
