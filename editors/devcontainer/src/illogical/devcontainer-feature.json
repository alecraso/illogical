{
  "id": "illogical",
  "version": "0.1.0",
  "name": "illogical",
  "description": "Puts this dev container's VS Code in your illogical swarm: the illogical daemon on the host, reached through its editors' socket.",
  "documentationURL": "https://github.com/jhgaylor/illogical/tree/main/editors/devcontainer",
  "options": {},
  "mounts": [
    {
      "source": "${localEnv:HOME}/.local/state/illogical/editors",
      "target": "/run/illogical",
      "type": "bind"
    }
  ],
  "containerEnv": {
    "ILLOGICAL_SOCK": "/run/illogical/sock"
  },
  "customizations": {
    "vscode": {
      "extensions": ["illogical.illogical-editor"]
    }
  }
}
