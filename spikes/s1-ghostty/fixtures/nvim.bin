ftp-data        20/tcp[K
ftp             21/tcp[K
fsp             21/udp          fspd[K
ssh             22/tcp                          # SSH Remote Login Protocol[K
telnet          23/tcp[K
smtp            25/tcp          mail[K
time            37/tcp          timserver[K
