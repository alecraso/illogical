{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "illogical",
  "identifier": "wtf.widgets.illogical",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Terminals that outlive their windows",
    "longDescription": "illogical keeps your terminals running in a daemon on this machine, so they\noutlive their windows. Watch and take them over from this app, a browser or\nyour phone, and reach your other machines through illogical control.\nThe app carries illogicald and installs it as a user service on first start.",
    "publisher": "Jake Gaylor <hello@illogical.widgets.wtf>",
    "homepage": "https://illogical.widgets.wtf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0",
      "files": {
        "Library/LaunchAgents/wtf.widgets.illogical.daemon.plist": "macos/wtf.widgets.illogical.daemon.plist"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libc6 (>= 2.35)", "libasound2", "libstdc++6"],
        "recommends": ["python3-nautilus"],
        "desktopTemplate": "linux/illogical.desktop",
        "files": {
          "/usr/share/nautilus-python/extensions/illogical.py": "linux/nautilus/illogical.py"
        }
      },
      "rpm": {
        "recommends": ["nautilus-python"],
        "desktopTemplate": "linux/illogical.desktop",
        "files": {
          "/usr/share/nautilus-python/extensions/illogical.py": "linux/nautilus/illogical.py"
        }
      }
    },
    "externalBin": [
      "binaries/illogicald",
      "binaries/illogical"
    ],
    "resources": {
      "THIRD_PARTY.md": "THIRD_PARTY.md",
      "../../THIRD_PARTY.md": "THIRD_PARTY-daemon.md",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE"
    },
    "copyright": "MIT OR Apache-2.0"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["illogical"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/arugula-salad/illogical/releases/latest/download/latest.json"]
    }
  }
}
