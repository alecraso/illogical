{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arugula",
  "identifier": "io.arugula.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Terminals that outlive their windows",
    "longDescription": "Arugula keeps your terminals running in a daemon on this machine, so they\noutlive their windows. Watch and take them over from this app, a browser or\nyour phone, and reach your other machines through Arugula control.\nThe app carries arugulad and installs it as a user service on first start.",
    "publisher": "Jake Gaylor <hello@illogical.widgets.wtf>",
    "homepage": "https://arugula.io",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0",
      "files": {
        "Library/LaunchAgents/io.arugula.desktop.daemon.plist": "macos/io.arugula.desktop.daemon.plist"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libc6 (>= 2.35)", "libasound2", "libstdc++6"],
        "recommends": ["python3-nautilus"],
        "conflicts": ["illogical"],
        "replaces": ["illogical"],
        "desktopTemplate": "linux/arugula.desktop",
        "files": {
          "/usr/share/nautilus-python/extensions/arugula.py": "linux/nautilus/arugula.py"
        }
      },
      "rpm": {
        "recommends": ["nautilus-python"],
        "obsoletes": ["illogical"],
        "desktopTemplate": "linux/arugula.desktop",
        "files": {
          "/usr/share/nautilus-python/extensions/arugula.py": "linux/nautilus/arugula.py"
        }
      }
    },
    "externalBin": [
      "binaries/arugulad",
      "binaries/arugula"
    ],
    "resources": {
      "THIRD_PARTY.md": "THIRD_PARTY.md",
      "../../THIRD_PARTY.md": "THIRD_PARTY-daemon.md",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE"
    },
    "copyright": "MIT OR Apache-2.0"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["arugula", "illogical"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwRjAyRDZBMDc4RDg3NDQKUldSRWg0MEhhaTN3MEpiYXJGK2Y1NnUzdmZhOGNZdUZHUWFyK0NDQ3M5Z0VsM0xJdE5kQWFGTTkK",
      "endpoints": ["https://github.com/arugula-salad/arugula/releases/download/app-latest/latest.json"]
    }
  }
}
