{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "illogical",
  "identifier": "wtf.widgets.illogical",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Terminals that outlive their windows",
    "longDescription": "illogical keeps your terminals running in a daemon on this machine, so they\noutlive their windows. Watch and take them over from this app, a browser or\nyour phone, and reach your other machines through illogical control.\nThe app carries illogicald and installs it as a user service on first start.",
    "publisher": "Jake Gaylor <hello@illogical.widgets.wtf>",
    "homepage": "https://illogical.widgets.wtf",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": ["libc6 (>= 2.35)"]
      }
    },
    "externalBin": [
      "binaries/illogicald",
      "binaries/illogical"
    ],
    "resources": {
      "THIRD_PARTY.md": "THIRD_PARTY.md",
      "../../THIRD_PARTY.md": "THIRD_PARTY-daemon.md",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE"
    },
    "copyright": "MIT OR Apache-2.0"
  }
}
