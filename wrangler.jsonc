// The project page: static assets on Cloudflare (Workers static assets, which
// is what Pages now runs on), at arugula.io (env `io`, in the Arugula
// account, where that zone is) and still at illogical.widgets.wtf (the
// default, in Jake's account), which installed binaries name for
// install.sh and install.ps1. `just site-deploy` deploys both.
// *.illogical.widgets.wtf is the daemon's tailnet-only block sites and is
// a separate DNS record this never touches.
{
  "name": "arugula",
  "compatibility_date": "2026-10-01",
  "account_id": "fc4c5df4e1392e524206c4d3fb91505b",
  "assets": { "directory": "./target/site" },
  "routes": [{ "pattern": "illogical.widgets.wtf", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "io": {
      "name": "arugula",
      "account_id": "6d56cda2737f29784c3555a6c3e2c113",
      "routes": [
        { "pattern": "arugula.io", "custom_domain": true },
        { "pattern": "www.arugula.io", "custom_domain": true }
      ]
    }
  }
}
